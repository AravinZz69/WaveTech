# Neon PostgreSQL (https://neon.tech)
DATABASE_URL="postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="replace-with-32-plus-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini API (https://aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_API_KEY_FALLBACK=""

# Optional: DeepSeek fallback for high-volume text generation
DEEPSEEK_API_KEY=""

# Cron / 4-hour job sync protection
CRON_SECRET="replace-with-cron-secret"

# Optional: Job Aggregator APIs (JSearch / Adzuna)
RAPIDAPI_JSEARCH_KEY=""
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
